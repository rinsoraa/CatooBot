# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# CatooBot runtime data
data/*.db
data/*.db-*
logs/*.log*

# Local secrets / config
.env
config/config.yaml
config/character_bible.md

# WebUI frontend (deps are never committed; dist IS committed — the
# aiohttp server serves it, and no Node toolchain is required at runtime)
node_modules/
webui/.vite/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Editor / tooling artifacts (ZCode)
.zcode/
.zcodeignore

# WebUI-managed overrides (machine-written, operator-local)
config/overrides.yaml

# Runtime data / logs (recreated on first run)
data/
logs/
