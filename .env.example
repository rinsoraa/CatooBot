# ============================================================
# CatooBot 环境变量示例
# 复制为 .env 后填写；.env 已被 gitignore，不要提交真实密钥
# ============================================================

# ---------- AI 模型 API Key ----------
# config.yaml 里 models.providers 的 api_key_env 指向这些变量。
# 填了哪个平台就启用哪个平台；变量名要与 models.providers 里的 api_key_env 一致。
# Workbuddy2API（本地 OpenAI 兼容接口，默认 base_url: http://127.0.0.1:7864/v1）
WORKBUDDY_API_KEY=
# SiliconFlow（embedding / 视觉等多模态模型）
SILICONFLOW_API_KEY=
# 其它平台（按需添加，并在 models.providers 里声明同名 api_key_env）
# DEEPSEEK_API_KEY=

# ---------- 工具凭据 ----------
# 联网搜索（tools.configs.web_search 的 api_key_env）
TAVILY_API_KEY=

# ---------- 安全 / 凭据 ----------
# OneBot WebSocket access token（与 NapCat 网络配置中的 Token 一致）
CATOOBOT_ONEBOT_ACCESS_TOKEN=
# WebUI 管理后台登录密码（首次启动创建 admin 账号时使用）
CATOOBOT_WEB_PASSWORD=

# ---------- 可选：覆盖 config.yaml 里的部署项（CATOOBOT_* 前缀，优先于 YAML） ----------
# CATOOBOT_ONEBOT_HOST=127.0.0.1
# CATOOBOT_ONEBOT_PORT=8080
# CATOOBOT_ONEBOT_PATH=/onebot/v11/ws
# CATOOBOT_BOT_NAME=CatooBot
# CATOOBOT_BOT_DEBUG=true
# CATOOBOT_LOG_LEVEL=INFO
# CATOOBOT_LOG_COLOR=true
# CATOOBOT_LOG_NARRATE=true
# CATOOBOT_DATABASE_URL=sqlite:///data/catoobot.db
